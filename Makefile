# Compiler
CXX = g++
CXXFLAGS = -std=c++17 -O2 -Wall -Werror -Wextra -Iinclude -MMD -MP

# Sources (shared by the program and the tests)
LIB_SRC = src/types.cpp src/token.cpp src/lexer.cpp \
          src/node_number.cpp src/node_var.cpp src/node_constant.cpp \
          src/node_binaryop.cpp src/node_unaryop.cpp src/node_func.cpp \
          src/simplify.cpp src/compare.cpp src/format.cpp src/expand.cpp src/parser.cpp src/repl.cpp

# Tests (GoogleTest, install with: sudo dnf install gtest-devel)
TEST_SRC = tests/test_lexer.cpp tests/test_nodes.cpp tests/test_simplify.cpp tests/test_parser.cpp \
           tests/test_substitute.cpp tests/test_repl.cpp tests/test_compare.cpp tests/test_format.cpp tests/test_expand.cpp

GTEST_CFLAGS = $(shell pkg-config --cflags gtest_main)
GTEST_LIBS   = $(shell pkg-config --libs gtest_main)

# Object files
LIB_OBJ  = $(LIB_SRC:.cpp=.o)
MAIN_OBJ = main.o
TEST_OBJ = $(TEST_SRC:.cpp=.o)
DEP      = $(LIB_OBJ:.o=.d) $(MAIN_OBJ:.o=.d) $(TEST_OBJ:.o=.d)

# Targets
TARGET      = mateck
TEST_TARGET = mateck_tests

# Default target
all: $(TARGET)

# Linking
$(TARGET): $(LIB_OBJ) $(MAIN_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $^

$(TEST_TARGET): $(LIB_OBJ) $(TEST_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(GTEST_LIBS)

# Build and run the tests
test: $(TEST_TARGET)
	./$(TEST_TARGET)

# Compile .cpp -> .o
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

tests/%.o: tests/%.cpp
	$(CXX) $(CXXFLAGS) $(GTEST_CFLAGS) -c $< -o $@

# Clean up
clean:
	rm -f $(LIB_OBJ) $(MAIN_OBJ) $(TEST_OBJ) $(DEP) $(TARGET) $(TEST_TARGET)

# Full rebuild
rebuild: clean all

.PHONY: all test clean rebuild

# Header dependencies (generated by -MMD)
-include $(DEP)
